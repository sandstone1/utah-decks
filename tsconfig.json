{
    "extends" : "astro/tsconfigs/strict",
    "compilerOptions" : {
        "jsx"              : "preserve", // stops TS from trying to turn JSX into React.createElement
        "jsxImportSource"  : "react",
        "baseUrl"          : ".",
        "paths"            : {
            "@/*" : [ "src/*" ]
        }
    },
    "include" : [
        "src/**/*",
        ".astro/types.d.ts"
    ],
    "exclude" : [
        "node_modules",
        "dist"
    ]
}
