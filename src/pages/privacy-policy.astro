---

// src/pages/privacy-policy.astro
import Layout from '../layouts/main-layout.astro';
import HeroHeaderComponent from '../components/react/hero/hero-header-v2.jsx';
import styles from './privacy-policy.module.scss';

---

<Layout>

    {
        /*
            page specific meta tags
        */
    }
    <!-- page specific meta tags -->
    <meta slot="head" name="keywords" content='custom deck builder Salt Lake City, deck builder Utah, custom deck builder Draper Utah, composite deck installation Utah, deck contractor near me, Trex deck installer Utah, TimberTech deck builder Utah, helical pier deck footings, composite deck railing installation, pergola builder Salt Lake County, deck demolition and replacement, custom deck stairs builder, deck builder Salt Lake County, deck builder Utah County, deck builder Davis County, Utah Decks' />
    <meta slot="head" name="description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:image" content='/images/mj_decks_02_1032.jpg' />
    <meta slot="head" property="og:title" content='Privacy Policy | Utah Decks & Pergolas' />
    <meta slot="head" property="og:description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:site_name" content='Utah Decks & Pergolas' />
    <meta slot="head" property="og:url" content='https://utahdecks.net/privacy-policy' />
    <meta slot="head" property="og:type" content='website' />
    <meta slot="head" property="og:locale" content="en_US" />
    <link slot="head" rel="canonical" href='https://utahdecks.net/privacy-policy' />
    <title slot="head">Privacy Policy | Utah Decks & Pergolas</title>

    <!-- stop Google from crawling this site until I have an office address on the site -->
    <!-- remove this line of code and think about updating my public/robots.txt file when I'm ready -->
    <meta name="robots" content="noindex, nofollow" />

    {
        /*
            // ==============================
            // container
            // ==============================
        */
    }

    <div class={ styles.privacyPolicyContainer }>

        <HeroHeaderComponent client:load />

        {
            /*
                // ==============================
                // container > div 2 ( wrapper div )
                // ==============================
            */
        }
        <div>

            <h1>Privacy Policy</h1>

            <p>Last updated: September 2, 2026</p>

            <p>Your privacy matters to us. This policy explains what information we collect,
            how we use it, and your rights. Questions? Send us a message using our contact
            form on the <a href="/contact">contact page</a>.</p>

            <h2>Who We Are</h2>

            <p>Utah Decks & Pergolas is a custom deck building company serving Salt Lake, Utah, and
            Davis counties.</p>

            <h2>Information We Collect</h2>

            <p>When you fill out a contact form or sign up for our newsletter, you may
            share your name, email address, phone number, and any details included in
            your message.</p>

            <h2>What We Collect Automatically</h2>

            <p>
                We use Google Analytics, Google Search Console, and Google Tag Manager
                to monitor website traffic and performance. These tools may collect your
                IP address, browser type, device type, pages visited, and how you arrived
                at our site. Our website may also include tracking pixels from Google Ads
                and Meta to measure the performance of our paid ad campaigns. You can
                manage your preferences via
                <a href="https://adssettings.google.com/">Google Ad Settings</a> and
                <a href="https://accountscenter.facebook.com/ads/">Meta Ad Preferences</a>.
            </p>

            <h2>How We Use Your Information</h2>

            <ul>
                <li>To respond to your inquiries</li>
                <li>To send newsletters you've opted into (unsubscribe any time)</li>
                <li>To improve our website and measure ad campaign performance</li>
            </ul>

            <h2>We Do Not Sell Your Data</h2>

            <p>We do not rent, sell, or share your personal information with third
            parties. Period.</p>

            <h2>Your Rights</h2>

            <p>You have the right to access, correct, or request deletion of your personal
            information at any time. Just email us using our contact form on our contact
            page and we'll take care of it promptly.</p>

            <h2>Third-Party Links</h2>

            <p>Our site may link to external websites. Once you leave our site, this
            policy no longer applies.</p>

            <h2>Changes to This Policy</h2>

            <p>We may update this policy from time to time. The "Last updated" date
            at the top will always reflect the most recent version.</p>

        </div>

    </div>

</Layout>

