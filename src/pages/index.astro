// import in the Ranking Made Easy Website component
import RankingMadeEasyWebsiteComponent from '../components/react/websites/ranking-made-easy-gradient-bg-v3';
*/


// import in the Where You Can Find Us component
import WhereYouCanFindUsComponent from '../components/react/where-you-can-find-us/where-you-can-find-us-v6';
// import in the ContactVideoComponent
import ContactVideoComponent from '../components/react/contact/contact-video-v2';
// import in the scss file
import styles from './index.module.scss';


// ==============================
// hero images
// ==============================

// define your static image file paths
const img480  = "/images/mj_decks_02_480.webp";
const img1032 = "/images/mj_decks_02_1032.webp";
const img1376 = "/images/mj_decks_02_1376.webp";
const img1728 = "/images/mj_decks_02_1728.webp";
const img2560 = "/images/mj_decks_02_2560.webp";

const srcset = `${ img480 } 480w, ${ img1032 } 1032w, ${ img1376 } 1376w, ${ img1728 } 1728w, ${ img2560 } 2560w`;

// 2. IMPORT THE CLEANED TEXT ANIMATION COMPONENT (WITHOUT THE IMAGE INDEED)
import HeroText from '../components/react/hero-image/index/hero-image-v5';

---

<Layout>

    {
        /*
            Structured data as JSON-LD markup
        */
    }
    <script slot="head" type="application/ld+json"
        set:html={ 
            JSON.stringify(
                {
                    "@context": "http://schema.org",
                    "@type": "LocalBusiness",
                    "name": "Utah Decks & Pergolas",
                    "url": "https://utahdecks.net"
                }
            )
        }
    >
    </script>

    <!-- page specific meta tags -->
    <meta slot="head" name="keywords" content='custom deck builder Salt Lake City, deck builder Utah, custom deck builder Draper Utah, composite deck installation Utah, deck contractor near me, Trex deck installer Utah, TimberTech deck builder Utah, helical pier deck footings, composite deck railing installation, pergola builder Salt Lake County, deck demolition and replacement, custom deck stairs builder, deck builder Salt Lake County, deck builder Utah County, deck builder Davis County, Utah Decks' />
    <meta slot="head" name="description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:image" content='/images/mj_decks_02_1032.jpg' />
    <meta slot="head" property="og:title" content='Deck Builder in Utah | Utah Decks & Pergolas' />
    <meta slot="head" property="og:description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:site_name" content='Utah Decks & Pergolas' />
    <meta slot="head" property="og:url" content='https://utahdecks.net' />
    <meta slot="head" property="og:type" content='website' />
    <meta slot="head" property="og:locale" content="en_US" />
    <link slot="head" rel="canonical" href="https://utahdecks.net" />
    <title slot="head">Deck Builder in Utah | Utah Decks & Pergolas</title>

    <!-- stop Google from crawling this site until I have an office address on the site -->
    <!-- remove this line of code and think about updating my public/robots.txt file when I'm ready -->
    <!-- <meta name="robots" content="noindex, nofollow" /> -->

    {
        /*
            // ==============================
            // container
            // ==============================
        */
    }
    <div class={ styles.homePageContainer }>

        {
            /*
                // ==============================
                // container > div 1
                //
                // in order to eliminate initial page jank, the hero component has to be
                // client:load when using gsap ( see notes in the hero component for details )
                // ==============================

                <HeroComponent client:load />
            */
        }

        <!-- new wrapper -->
        <div class="hero-container">
                
            <!-- native image and found immediately inside HTML and painted right away -->
            <img
                src={ img2560 }
                srcset={ srcset }
                sizes="( max-width: 480px ) 100vw, ( max-width: 1032px ) 100vw, ( max-width: 1376px ) 100vw, ( max-width: 1728px ) 100vw, 2560px"
                alt="Beautiful modern custom deck construction layout"
                class="hero-native-bg"
                fetchpriority="high"
                loading="eager"
                style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
            />

        </div>


        {
            /*
                // ==============================
                // container > div 2
                // ==============================
            */
        }
        <ContactUsComponent client:visible />

        {
            /*
                // ==============================
                // container > div 3
                // ==============================
            */
        }
        <ByTheNumbersComponent client:visible />

        {
            /*
                // ==============================
                // container > div 4
                // ==============================
            */
        }
        <ServicesComponent client:visible />

        {
            /*
                // ==============================
                // container > div 6
                // ==============================
                <WhyChooseUsComponent client:visible />
            */
        }

        {
            /*
                // ==============================
                // container > div 11
                // ==============================
                <WhereYouCanFindUsComponent client:visible />
            */
        }
        

        {
            /*
                // ==============================
                // container > div 12
                // ==============================
                <CimikoskiStemCellsWebsiteComponent client:load />
            */
        }

        {
            /*
                // ==============================
                // container > div 15
                //
                // use my intersection observer, do not use client:visible and client:only="react"
                // downloads the JS upfront but skips SSR — our internal Intersection Observer
                // controls exactly when the content appears
                // ==============================
                <ContactVideoComponent client:load />
            */
        }

    </div>

</Layout>

<style is:global lang="scss">
    
    @use '../styles/_mixins.scss' as *;
    @use '../styles/_responsive_breakpoints.scss' as *;

    .hero-container {

        // parent
        grid-area   : div1; // needed in order for the parent container
        grid-column : 1 / -1; // needed in order to fill the parent container

        // children
        display               : grid;

        // ==============================
        // note 
        // ==============================

        // ==============================
        // 1 - in the content div use grid-column to position against the parent grid and until we
        // can use sub grid we may need to duplicate the parent grid and bring it down to the
        // content div where we can position against it
        // 2 - now our content div is sitting empty inside the parent grid we need to give the
        // content div a width and height so we can create the content box and
        // 3 - then set up a grid within the content box so that we can layout the content
        // inside the content box as needed and
        // 4 - the only cavet to 3 above, is that sometimes we need to go with a horizontal layout
        // and in those cases, flexbox may be the better choice than css grid
        // ==============================

        grid-template-columns : minmax( 8rem, 1fr )                          // col 1 - 2   ( column 1 )
                                repeat( 20, minmax( min-content, 12.0rem ) ) // col 2 - 22  ( column 2 - 22 )
                                minmax( 8rem, 1fr );                         // col 22 - 23 ( column 23 )

        // ==============================
        // remember, I can center the wrapper div by using either " justify-items : center; "
        // in the parent div ( see below ) or by using " margin : 0 auto; " in the
        // wrapper div
        // ==============================

        align-content       : center;
        justify-items       : center;
    
        // needed in order to center the content
        position : absolute;
        left     : 0;
        top      : 0;
        right    : 0;
        // bottom   : 0; // important!! ( see the notes below )

        /*
        position : relative;
        width    : 100%;
        height   : 100vh; 
        overflow : hidden;
        z-index  : 1;
        */

        z-index : 1;
    
        // ==============================
        // height
        // ==============================

        // ==============================
        // on larger screens, set the height of the hero container to 100vh or 100svh and this
        // will make the background image span the entire screen or viewport and only span the
        // viewport and we want this effect on larger screens
        // ==============================

        height : 100vh; // make sure to adjust the margin top for the next container

        // ==============================
        // @supports
        // ==============================

        // use @supports to test for " 100svh "

        // see the following article for details on @supports : 
        // " https://css-tricks.com/how-supports-works/ "
        @supports ( height : 100svh ) {

            min-height : max( 100.0rem, 100svh );
            // height : 100svh; // remember, svh stands for smallest virewport height and unlike
            // 100vh, which causes the hero container to overflow into div2 on some mobiles
            // devices, 100svh takes into account any mobile bars, etc. and seems to work
            // pretty well

            // remember, 100svh and 100vh are the same on desktop since desktops don't have
            // any mobile bars, etc. to contend with

            // make sure to adjust the margin top for the next container

        } // end of container > @supports ( height : 100svh )

        // ==============================
        // end of @supports
        // ==============================

        // for shorter screens, make sure change align-content to start and add padding top
        // and we do the same omce max-width equals 1376px
        /*
            So practically, for your CSS math specifically :

            Most common actual height: 1080px (physical), but the CSS viewport height the
            browser reports is usually a bit less than that once you subtract the browser
            chrome ( address bar, bookmarks bar, etc. ) — typically landing somewhere
            around 900–950px of visible content height in a maximized browser window.

            1366×768 is still common enough to design around, especially for older/budget
            laptops — it represents over 10% of desktop users in the US even now.

            1536×864 (the Windows-scaled version) is worth treating as its own real
            breakpoint target since it's increasingly common due to display scaling, not
            just a rare edge case.

            A reasonable design baseline, combining these: treat ~900px viewport height as
            your "typical laptop" target for anything height-dependent
        */
        @media all and ( max-height : 1079px ) {

            align-content : start; // visual preference

            padding : calc( 160px + 12.0rem ) 0 0 0; // add some spacing between the header and the content divs
        
        } // end of container > ( max-height : 1000px )

        // ==============================
        // end of height
        // ==============================

        // ==============================
        // background color
        // ==============================

        // this the best color that match the first video and will use this as my background
        // color and hopefully save a network request by eliminating 
        // background-image : url( /images/lama_bg_01.webp );
        // background-color : rgba( 17, 11, 84, 1 );

        background-size       : cover;
        background-blend-mode : multiply;
        background-color      : var( --blue-85-2 );
        background-color      : rgba( 13, 58, 216, 0.80 );

        // ==============================
        // end of background color
        // ==============================
/*
        // ==============================
        // fallback jpeg image
        // ==============================

        background-image : url( /images/mj_decks_02_2560.jpg );

        @media all and ( max-width : $bp-1728 ) {
        
            background-image : url( /images/mj_decks_02_1728.jpg );

        } // end of bp-1728

        @media all and ( max-width : $bp-1376 ) {
            
            background-image : url( /images/mj_decks_02_1376.jpg );

        } // end of bp-1376

        @media all and ( max-width : $bp-1032 ) {
        
            background-image : url( /images/mj_decks_02_1032.jpg );

        } // end of bp-1032

        @media all and ( max-width : $bp-480 ) {

            // this is an cropped image
            background-image    : url( /images/mj_decks_02_480.jpg );

        } // end of bp-480

        // ==============================
        // end of fallback jpeg image
        // ==============================

        // ==============================
        // webp image
        // ==============================

        // this code comes from the article :
        // " https://www.js-craft.io/blog/css-fallbacks-for-webp-background-images-with-supports/ "
        @supports ( background-image : url( /images/mj_decks_02_2560.webp ) ) {

            background-image : url( /images/mj_decks_02_2560.webp );

            @media all and ( max-width : $bp-1728 ) {
        
                background-image : url( /images/mj_decks_02_1728.webp );

            } // end of bp-1728

            @media all and ( max-width : $bp-1376 ) {
        
                background-image : url( /images/mj_decks_02_1376.webp );

            } // end of bp-1376

            @media all and ( max-width : $bp-1032 ) {
        
                background-image : url( /images/mj_decks_02_1032.webp );

            } // end of bp-1032

            @media all and ( max-width : $bp-480 ) {

                // this is an cropped image
                background-image : url( /images/mj_decks_02_480.webp );

            } // end of bp-480

        } // end of container > @supports

        // ==============================
        // end of webp image
        // ==============================
*/
        // ==============================
        // remember, at bp-1376 and below we changed 100svh to 100rem or a fixed height and we
        // did this so that we could fix the hero section content jumping that was caused by
        // the disappearing address bar ( resulting in a terrible user experience) when scrolling
        // up and down on the hero section and the content jumping did not happen on Safari but
        // did happen on Chrome
        // ==============================

        // this is for the 2024 iPad Pro 13 inch with a viewport size of 1032 x 1376
        @media all and ( max-width : $bp-1376 ) {

            align-content : start; // visual preference

            // added a little extra, given all the content in this hero section
            height     : 100.0rem; // make sure to adjust the margin top for the next container
            min-height : 100vh;
            padding    : calc( 160px + 12.0rem ) 0 0 0; // add some spacing between the header and the content divs

        } // end of container > end of bp-1376

        // ==============================
        // end of height
        // ==============================

        // ==============================
        // tighten up side margins
        // ==============================

        @media all and ( max-width : $bp-1280 ) {

            grid-template-columns : minmax( 6rem, 1fr )                          // col 1 - 2   ( column 1 )
                                    repeat( 20, minmax( min-content, 12.0rem ) ) // col 2 - 22  ( column 2 - 22 )
                                    minmax( 6rem, 1fr );                         // col 22 - 23 ( column 23 )

            // remember, we are trying to match the most common height value by screen size according
            // StatCounter in the 1032 to 1280 range and in this range the height values become
            // smaller so in this case we want to make sure we have enough height for the 2024 iPad
            // Pro 11 or 834 * 1091
            // height     : 83.4rem; // make sure to adjust the margin top for the next container
            // added a little extra, given all the content in this hero section
            height     : 100.0rem; // make sure to adjust the margin top for the next container
            min-height : 100vh;

        } // end of container > end of bp-1280

        // ==============================
        // end of tighten up side margins
        // ==============================

        // ==============================
        // height
        // ==============================

        // remember, we are trying to match the most common height values by screen size according
        // StatCounter and in this case we are looking at common screen sizes for tablets
        @media all and ( max-width : $bp-1032 ) {

            height : calc( 137.6rem * 1.1 ); // make sure to adjust the margin top for the next container

        } // end of container > end of bp-1032

        // remember, we are trying to match the most common height values by screen size according
        // StatCounter and in this case we are looking at common screen sizes for tablets
        @media all and ( max-width : $bp-920 ) {

            height : calc( 128.0rem * 1.1 ); // make sure to adjust the margin top for the next container

        } // end of container > end of bp-920

        // remember, we are trying to match the most common height values by screen size according
        // StatCounter and in this case we are looking at common screen sizes for mobile devices
        // or more specially, make sure we have enough height for the latest iPhones or 440 x 956

        // 105.16rem works out to 956px on a mobile device
        @media all and ( max-width : $bp-620 ) {

            height  : 116.00rem; // make sure to adjust the margin top for the next container
            // and had to change from 105.16 to 116.00 to make sure we had enough room to fit
            // all the content
            padding : calc( 160px + 11.1rem ) 0 0 0; // add some spacing between the header and the content divs
            // and remmeber changed padding to 11.1rem from 12.0rem since the header height changed to 151px
            // from 160px

        } // end of container > bp-620

        // 105.16rem works out to 956px on a mobile device
        @media all and ( max-width : $bp-480 ) {

            height : 130.00rem; // make sure to adjust the margin top for the next container
            // and had to change from 105.16 to 130.00 to make sure we had enough room to fit
            // all the content

        } // end of container > bp-480

        // 105.16rem works out to 956px on a mobile device
        @media all and ( max-width : 426px ) {

            padding : calc( 160px + 13.0rem ) 0 0 0; // add some spacing between the header and the content divs

        } // end of container > 426px

        // ==============================
        // remember, in this case, we keep the height at 105.16rem in order to prevent the content
        // from spilling over into the next div
        // ==============================

        // remember, we are trying to match the most common height values by screen size according
        // StatCounter and in this case we are looking at common screen sizes for mobile devices
        // or more specially, make sure we reduce the height for mobile devices at or below bp-375
        // and more specifically we want to target the viewport size of 375 * 812 since according
        // to StatCounter this screen size is the most popular screen size for any mobile phone on
        // the market in November 2024

        // 90.3rem works out to 812.7px on a mobile device
        @media all and ( max-width : $bp-375 ) {

            // needed for this project in order for the content not to spill over to the next div
            height : 145.0rem; // make sure to adjust the margin top for the next container

        } // end of container > bp-375

    }


</style>

