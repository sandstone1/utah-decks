---

// import in the Layout component
import Layout from '../layouts/main-layout.astro';
// import in the Hero component
import HeroComponent from '../components/react/hero-image/index/hero-image-v5';
// import in the By The Numbers component
import ByTheNumbersComponent from '../components/react/by-the-numbers/by-the-numbers-v3';
// import in the WhatWeDo component
import ServicesComponent from '../components/react/services/services-v2';
// import in the Contact Us component
import ContactUsComponent from '../components/react/contact-us/contact-us-v6';
// import in the Contact Us component
import WhyChooseUsComponent from '../components/react/why-choose-us/why-choose-us-v2';


/*
// import in the Infinite Scroll component
import InfiniteScrollComponent from '../components/react/infinite-scroll/infinite-scroll-v2';
// import in the Why Work With Us component
import WhyWorkWithUsComponent from '../components/react/why-work-with-us/why-work-with-us-video-no-calc-v5';
// import in the Sticky Pictures component
import StickyPicturesComponent from '../components/react/animations/scroll-driven/sticky-pictures/sticky-pictures-v9';
// import in the Our Process dark component
import OurProcessDarkComponent from '../components/react/our-process/our-process-dark-v3';
// import in the Our Process light component
import OurProcessLightComponent from '../components/react/our-process/our-process-light';
// import in the Pricing component
import PricingRadialGradientComponent from '../components/react/pricing/pricing-radial-gradient-v5';
// import in the Where You Can Find Us component
import WhereYouCanFindUsComponent from '../components/react/where-you-can-find-us/where-you-can-find-us-v4';
// import in the Cimikoski Stem Cells Website component
import CimikoskiStemCellsWebsiteComponent from '../components/react/websites/cimikoski-stem-cells-v2';
// import in the Real Estate Broker Website component
import RealEstateBrokerWebsiteComponent from '../components/react/websites/real-estate-broker-gray-bg-v2';
// import in the Ranking Made Easy Website component
import RankingMadeEasyWebsiteComponent from '../components/react/websites/ranking-made-easy-gradient-bg-v3';
*/


// import in the Where You Can Find Us component
import WhereYouCanFindUsComponent from '../components/react/where-you-can-find-us/where-you-can-find-us-v6';
// import in the ContactVideoComponent
import ContactVideoComponent from '../components/react/contact/contact-video-v2';
// import in the scss file
import styles from './index.module.scss';

// 4. Define your static responsive image file paths
const img480  = "/images/mj-decks-02-480.webp";
const img1032 = "/images/mj-decks-02-1032.webp";
const img1376 = "/images/mj-decks-02-1376.webp";
const img1728 = "/images/mj-decks-02-1728.webp";
const img2560 = "/images/mj-decks-02-2560.webp";

const srcset = `${ img480 } 480w, ${ img1032 } 1032w, ${ img1376 } 1376w, ${ img1728 } 1728w, ${ img2560 } 2560w`;

// 2. IMPORT THE CLEANED TEXT ANIMATION COMPONENT (WITHOUT THE IMAGE INDEED)
import HeroText from '../components/react/hero-image/index/hero-image-v5';

---

<Layout>

    {
        /*
            Structured data as JSON-LD markup
        */
    }
    <script slot="head" type="application/ld+json"
        set:html={ 
            JSON.stringify(
                {
                    "@context": "http://schema.org",
                    "@type": "LocalBusiness",
                    "name": "Utah Decks & Pergolas",
                    "url": "https://utahdecks.net"
                }
            )
        }
    >
    </script>

    <!-- page specific meta tags -->
    <meta slot="head" name="keywords" content='custom deck builder Salt Lake City, deck builder Utah, custom deck builder Draper Utah, composite deck installation Utah, deck contractor near me, Trex deck installer Utah, TimberTech deck builder Utah, helical pier deck footings, composite deck railing installation, pergola builder Salt Lake County, deck demolition and replacement, custom deck stairs builder, deck builder Salt Lake County, deck builder Utah County, deck builder Davis County, Utah Decks' />
    <meta slot="head" name="description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:image" content='/images/mj_decks_02_1032.jpg' />
    <meta slot="head" property="og:title" content='Deck Builder in Utah | Utah Decks & Pergolas' />
    <meta slot="head" property="og:description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:site_name" content='Utah Decks & Pergolas' />
    <meta slot="head" property="og:url" content='https://utahdecks.net' />
    <meta slot="head" property="og:type" content='website' />
    <meta slot="head" property="og:locale" content="en_US" />
    <link slot="head" rel="canonical" href="https://utahdecks.net" />
    <title slot="head">Deck Builder in Utah | Utah Decks & Pergolas</title>

    <!-- stop Google from crawling this site until I have an office address on the site -->
    <!-- remove this line of code and think about updating my public/robots.txt file when I'm ready -->
    <meta name="robots" content="noindex, nofollow" />

    {
        /*
            // ==============================
            // container
            // ==============================
        */
    }
    <div class={ styles.homePageContainer }>

        {
            /*
                // ==============================
                // container > div 1
                //
                // in order to eliminate initial page jank, the hero component has to be
                // client:load when using gsap ( see notes in the hero component for details )
                // ==============================

            <HeroComponent client:load />
            */
        }

        <!-- NEW SOLUTION WRAPPER: Matches standard stacking layouts -->
        <div class="hero-stage-container" style="position: relative; width: 100%; height: 100vh; overflow: hidden;">
                
            <!-- NATIVE IMAGE: Found immediately inside HTML and painted within 183ms -->
            <img
            src={ img2560 }
            srcset={ srcset }
            sizes="( max-width: 480px ) 100vw, ( max-width: 1032px ) 100vw, ( max-width: 1376px ) 100vw, ( max-width: 1728px ) 100vw, 2560px"
            alt="Beautiful modern custom deck construction layout"
            class="hero-native-bg"
            fetchpriority="high"
            loading="eager"
            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
            />

            <!-- TEXT ANIMATION WRAPPER: Forces text layers cleanly over the native image -->
            <div style="position: relative; z-index: 2; height: 100%;">
                <HeroText client:load />
            </div>

        </div>

        {
            /*
                // ==============================
                // container > div 2
                // ==============================
            */
        }
        <ContactUsComponent client:visible />

        {
            /*
                // ==============================
                // container > div 3
                // ==============================
            */
        }
        <ByTheNumbersComponent client:visible />

        {
            /*
                // ==============================
                // container > div 4
                // ==============================
            */
        }
        <ServicesComponent client:visible />

        {
            /*
                // ==============================
                // container > div 6
                // ==============================
                <WhyChooseUsComponent client:visible />
            */
        }

        {
            /*
                // ==============================
                // container > div 11
                // ==============================
                <WhereYouCanFindUsComponent client:visible />
            */
        }
        

        {
            /*
                // ==============================
                // container > div 12
                // ==============================
                <CimikoskiStemCellsWebsiteComponent client:load />
            */
        }

        {
            /*
                // ==============================
                // container > div 15
                //
                // use my intersection observer, do not use client:visible and client:only="react"
                // downloads the JS upfront but skips SSR — our internal Intersection Observer
                // controls exactly when the content appears
                // ==============================
                <ContactVideoComponent client:load />
            */
        }

    </div>

</Layout>


<style>
    /* Keeps your stage sized to the browser view height */
    .hero-stage-container {
      position: relative;
      width: 100%;
      height: 100vh;
      background: transparent;
      overflow: hidden;
    }
  
    /* Locks your background image directly underneath your text */
    .hero-native-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
      display: block;
    }
  
    /* Pushes your React GSAP animation content down to the absolute bottom */
    .hero-text-container-wrapper {
      position: relative;
      z-index: 2;
      height: 100%;
      background: transparent;
      
      /* Flexbox variables controlling alignment */
      display: flex;
      flex-direction: column;
      justify-content: flex-end; /* This forces the text to the bottom */
      align-items: center;       /* Centers it horizontally */
      padding-bottom: 4rem;      /* Cushion from the screen edge */
    }
  </style>