        // on larger screens, set the height of the hero container to 100vh or 100svh and this
        // will make the background image span the entire screen or viewport and only span the
        // viewport and we want this effect on larger screens
        // ==============================

        height : 100vh; // make sure to adjust the margin top for the next container

        // ==============================
        // @supports
        // ==============================

        // use @supports to test for " 100svh "

        // see the following article for details on @supports : 
        // " https://css-tricks.com/how-supports-works/ "
        @supports ( height : 100svh ) {

            min-height : max( 100.0rem, 100svh );
            // height : 100svh; // remember, svh stands for smallest virewport height and unlike
            // 100vh, which causes the hero container to overflow into div2 on some mobiles
            // devices, 100svh takes into account any mobile bars, etc. and seems to work
            // pretty well

            // remember, 100svh and 100vh are the same on desktop since desktops don't have
            // any mobile bars, etc. to contend with

            // make sure to adjust the margin top for the next container

        } // end of container > @supports ( height : 100svh )

        // ==============================
        // end of @supports
        // ==============================

        // for shorter screens, make sure change align-content to start and add padding top
        // and we do the same omce max-width equals 1376px
        /*
            So practically, for your CSS math specifically :

            Most common actual height: 1080px (physical), but the CSS viewport height the
            browser reports is usually a bit less than that once you subtract the browser
            chrome ( address bar, bookmarks bar, etc. ) — typically landing somewhere
            around 900–950px of visible content height in a maximized browser window.

            1366×768 is still common enough to design around, especially for older/budget
            laptops — it represents over 10% of desktop users in the US even now.

            1536×864 (the Windows-scaled version) is worth treating as its own real
            breakpoint target since it's increasingly common due to display scaling, not
            just a rare edge case.

            A reasonable design baseline, combining these: treat ~900px viewport height as
            your "typical laptop" target for anything height-dependent
        */
        @media all and ( max-height : 1079px ) {

            align-content : start; // visual preference
        
        } // end of container > ( max-height : 1000px )

        // this is for the 2024 iPad Pro 13 inch with a viewport size of 1032 x 1376
        @media all and ( max-width : $bp-1376 ) {

            // added a little extra, given all the content in this hero section
            height     : 100.0rem; // make sure to adjust the margin top for the next container
            min-height : 100vh;
        } // end of container > end of bp-1376

        @media all and ( max-width : $bp-1280 ) {

            // remember, we are trying to match the most common height value by screen size according
            // StatCounter in the 1032 to 1280 range and in this range the height values become
            // smaller so in this case we want to make sure we have enough height for the 2024 iPad
            // Pro 11 or 834 * 1091
            // height     : 83.4rem; // make sure to adjust the margin top for the next container
            // added a little extra, given all the content in this hero section
            height     : 100.0rem; // make sure to adjust the margin top for the next container
            min-height : 100vh;

        } // end of container > end of bp-1280

        // remember, we are trying to match the most common height values by screen size according
        // StatCounter and in this case we are looking at common screen sizes for tablets
        @media all and ( max-width : $bp-1032 ) {

            height : calc( 137.6rem * 1.1 ); // make sure to adjust the margin top for the next container

        } // end of container > end of bp-1032

        // remember, we are trying to match the most common height values by screen size according
        // StatCounter and in this case we are looking at common screen sizes for tablets
        @media all and ( max-width : $bp-920 ) {

            height : calc( 128.0rem * 1.1 ); // make sure to adjust the margin top for the next container

        } // end of container > end of bp-920

        // remember, we are trying to match the most common height values by screen size according
        // StatCounter and in this case we are looking at common screen sizes for mobile devices
        // or more specially, make sure we have enough height for the latest iPhones or 440 x 956

        // 105.16rem works out to 956px on a mobile device
        @media all and ( max-width : $bp-620 ) {

            height  : 116.00rem; // make sure to adjust the margin top for the next container
            // and had to change from 105.16 to 116.00 to make sure we had enough room to fit
            // all the content

        } // end of container > bp-620

        // 105.16rem works out to 956px on a mobile device
        @media all and ( max-width : $bp-480 ) {

            height : 130.00rem; // make sure to adjust the margin top for the next container
            // and had to change from 105.16 to 130.00 to make sure we had enough room to fit
            // all the content

        } // end of container > bp-480

        // ==============================
        // remember, in this case, we keep the height at 105.16rem in order to prevent the content
        // from spilling over into the next div
        // ==============================

        // remember, we are trying to match the most common height values by screen size according
        // StatCounter and in this case we are looking at common screen sizes for mobile devices
        // or more specially, make sure we reduce the height for mobile devices at or below bp-375
        // and more specifically we want to target the viewport size of 375 * 812 since according
        // to StatCounter this screen size is the most popular screen size for any mobile phone on
        // the market in November 2024

        // 90.3rem works out to 812.7px on a mobile device
        @media all and ( max-width : $bp-375 ) {

            // needed for this project in order for the content not to spill over to the next div
            height : 145.0rem; // make sure to adjust the margin top for the next container

        } // end of container > bp-375

        // ==============================
        // end of height
        // ==============================

    }

