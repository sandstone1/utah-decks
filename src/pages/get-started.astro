---


// import in the Layout component
import Layout from '../layouts/main-layout.astro';
// import in the Hero header component
import HeroHeaderComponent from '../components/react/hero/hero-header';
// import in the Blob Blue background component
import BlobComponentOne from '../components/react/animations/blob/blob-v12';
// import in the Blob Blue background component
import BlobComponentTwo from '../components/react/animations/blob/blob-v13';
// import in the Material Design phone icon
import { MdOutlinePhoneAndroid } from "react-icons/md";
// import in the Bootstrap shield icon
import { BsShieldCheck } from "react-icons/bs";
// import in the Font Awesome star icon
import { FaRegStar } from "react-icons/fa6";
// import in our stylesheet
import styles from './get-started.module.scss';

---

<Layout>

    {
        /*
            page specific meta tags
        */
    }
    <!-- page specific meta tags -->
    <meta slot="head" name="keywords" content='custom deck builder Salt Lake City, deck builder Utah, custom deck builder Draper Utah, composite deck installation Utah, deck contractor near me, Trex deck installer Utah, TimberTech deck builder Utah, helical pier deck footings, composite deck railing installation, pergola builder Salt Lake County, deck demolition and replacement, custom deck stairs builder, deck builder Salt Lake County, deck builder Utah County, deck builder Davis County, Utah Decks' />
    <meta slot="head" name="description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:image" content='/images/mj_decks_02_1032.jpg' />
    <meta slot="head" property="og:title" content='Get Started | Utah Decks & Pergolas' />
    <meta slot="head" property="og:description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:site_name" content='Utah Decks & Pergolas' />
    <meta slot="head" property="og:url" content='https://utahdecks.net' />
    <meta slot="head" property="og:type" content='website' />
    <meta slot="head" property="og:locale" content="en_US" />
    <link slot="head" rel="canonical" href="https://utahdecks.net" />
    <title slot="head">Get Started | Utah Decks & Pergolas</title>

    <!-- stop Google from crawling this site until I have an office address on the site -->
    <!-- remove this line of code and think about updating my public/robots.txt file when I'm ready -->
    <meta name="robots" content="noindex, nofollow" />

    {
        /*
            // ==============================
            // container
            // ==============================
        */
    }

    <div class={ styles.freeDeckDesignContainer }>

        {
            /*
                // ==============================
                // container > ( hero component )
                // ==============================
            */
        }
        <HeroHeaderComponent client:load />

        {
            /*
                // ==============================
                // container > div 2 ( trust signals )
                // ==============================
            */
        }
        <div>

            <div>

                <MdOutlinePhoneAndroid style={ { verticalAlign : '-5.0px', margin : '0 -1.1rem 0 0', fontSize : '2.2rem' } } />

                <a
                    href="tel:385-425-2299"
                >
                    &#40;385&#41; 425&#45;2299
                </a>

            </div>

            <div>

                <BsShieldCheck style={ { verticalAlign: '-5.5px', fontSize: '2.15rem', margin: '0 1.0rem 0 0' } } />

                <span>Licensed & Insured</span>

            </div>

            <div>

                <FaRegStar style={ { verticalAlign: '-5.5px', fontSize: '2.3rem', margin: '0 1.0rem 0 0' } } />

                <span>300+ Happy Customers</span>

            </div>

        </div>

        {
            /*
                // ==============================
                // container > div 3 ( wrapper div )
                // ==============================
            */
        }
        <div>

            {
                /*
                    // ==============================
                    // container > div 3 ( wrapper div ) > div 1 ( section title )
                    // ==============================
                */
            }
            <div>
    
                <h1 class="contact-page-h1">Free <span style={ { color : 'var( --blue-77 )' } }>Deck Design</span> or Inspection</h1>
    
                <picture>
                    <source 
                        srcset="/images/underline_gray_870_02_512.png"
                        type="image/png"
                    />
                    <img
                        class="contact-page-image-underline"
                        src="/images/underline_gray_870_02_512.png"
                        width={ 512 }
                        height={ 48 }
                        loading="eager"
                        fetchpriority="high"
                        alt="Gray underline"
                    />
                </picture>
    
                <p class="drop-cap">
                    Pick a day and time that works for you. We'll walk your space, talk through
                    your vision, and put together a custom design with pricing you can actually
                    use — fast, free, and no pressure.
                </p>

            </div>

            {
                /*
                    // ==============================
                    // container > div 3 > div 2 ( GHL calendar )
                    // ==============================
                */
            }
            <div>

                <iframe src="https://api.leadconnectorhq.com/widget/booking/RrMEXlzJ4Y5xHRCSJ0OP" allow="payment" style="width: 100%;border:none;overflow: hidden;" scrolling="no" id="RrMEXlzJ4Y5xHRCSJ0OP_1789684779176"></iframe>
                
                <!--
                    comment out the script below and replace with the following 2 scripts
                -->
                <!-- <script is:inline src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script> -->

                <!--
                    the loadCalendarWithUtms() function sets the iframe's src to include UTM parameters, fixing
                    the UTM Facebook lead attribution issue; in other words, we should be able to see the FB UTM
                    parameters inside GHL and thereby know when a FB lead books an appointment
                -->
                <script is:inline>
                    function loadCalendarWithUtms() {
                        const iframe = document.getElementById( 'RrMEXlzJ4Y5xHRCSJ0OP_1789684779176' );
                        if ( !iframe ) return;

                        const params = new URLSearchParams( window.location.search );
                        const baseUrl = 'https://api.leadconnectorhq.com/widget/booking/RrMEXlzJ4Y5xHRCSJ0OP';
                        const utmParams = new URLSearchParams();

                        [ 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content' ].forEach( key =>
                            {
                                if ( params.has( key ) ) utmParams.set( key, params.get( key ) );
                            }
                        );

                        iframe.src = utmParams.toString() ? `${ baseUrl }?${ utmParams.toString() }` : baseUrl;
                    }

                    // run on initial page load
                    loadCalendarWithUtms();

                    // re-run on every Astro client-side navigation
                    document.addEventListener( 'astro:page-load', loadCalendarWithUtms );
                </script>

                <!-- 
                    due to using Astro view transitions, we had to modify the script tag above to
                    re-inject the script tag fresh on every navigation in order for the calendar
                    to work
                -->
                <script is:inline>
                    function loadGhlEmbedScript() {
                        // remove any existing copy so we get a clean re-run
                        const existing = document.querySelector( 'script[ src*="form_embed.js" ]' );
                        if ( existing ) existing.remove();
                
                        const s = document.createElement( 'script' );
                        s.src  = 'https://link.msgsndr.com/js/form_embed.js';
                        s.type = 'text/javascript';
                        document.body.appendChild( s );
                    }

                    // run on initial page load
                    loadGhlEmbedScript();

                    // re-run on every Astro client-side navigation
                    document.addEventListener( 'astro:page-load', loadGhlEmbedScript );
                </script>

            </div>

        </div>

        {
            /*
                // ==============================
                // container ( square or blob )
                // ==============================
            */
        }
        <BlobComponentOne client:visible />

        {
            /*
                // ==============================
                // container ( square or blob )
                // ==============================
            */
        }
        <BlobComponentTwo client:visible />

    </div>

</Layout>

