---

import Layout from '../layouts/main-layout.astro';
import HeroHeaderComponent from '../components/react/hero/hero-header-v2.jsx';
import styles from './terms-and-conditions.module.scss';

---


<Layout>


    {
        /*
            page specific meta tags
        */
    }
    <!-- page specific meta tags -->
    <meta slot="head" name="keywords" content='custom deck builder Salt Lake City, deck builder Utah, custom deck builder Draper Utah, composite deck installation Utah, deck contractor near me, Trex deck installer Utah, TimberTech deck builder Utah, helical pier deck footings, composite deck railing installation, pergola builder Salt Lake County, deck demolition and replacement, custom deck stairs builder, deck builder Salt Lake County, deck builder Utah County, deck builder Davis County, Utah Decks' />
    <meta slot="head" name="description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:image" content='/images/mj_decks_02_1032.jpg' />
    <meta slot="head" property="og:title" content='Terms & Conditions | Utah Decks & Pergolas' />
    <meta slot="head" property="og:description" content='Custom deck builder serving Salt Lake, Utah & Davis counties. Composite decking, pergolas, and railing — licensed, insured, free estimates.' />
    <meta slot="head" property="og:site_name" content='Utah Decks & Pergolas' />
    <meta slot="head" property="og:url" content='https://utahdecks.net' />
    <meta slot="head" property="og:type" content='website' />
    <meta slot="head" property="og:locale" content="en_US" />
    <link slot="head" rel="canonical" href="https://utahdecks.net" />
    <title slot="head">Terms & Conditions | Utah Decks & Pergolas</title>

    <!-- stop Google from crawling this site until I have an office address on the site -->
    <!-- remove this line of code and think about updating my public/robots.txt file when I'm ready -->
    <meta name="robots" content="noindex, nofollow" />

    {
        /*
            // ==============================
            // container
            // ==============================
        */
    }

    <div class={ styles.termsAndConditionsContainer }>

        <HeroHeaderComponent client:load />

        {
            /*
                // ==============================
                // container > div 2 ( wrapper div )
                // ==============================
            */
        }
        <div>

            <h1>Terms & Conditions</h1>

            <p>Last updated: September 2, 2026</p>

            <p>By engaging Utah Decks & Pergolas for any service, you agree to these terms.
            Questions? Send us a message using our request service email form on the{' '}
            <a href="/request-service">request service page.</a></p>

            <h2>Who We Are</h2>

            <p>Utah Decks & Pergolas is a custom deck building company serving Salt Lake, Utah,
            and Davis counties.</p>

            <h2>Age Requirement</h2>

            <p>You must be at least 18 years old to engage our services or enter into
            an agreement with Utah Decks & Pergolas.</p>

            <h2>Third-Party Platforms</h2>

            <p>Our services may involve platforms such as Google, Meta, or other marketing
            and hosting services. We are not responsible for changes, outages, or policy
            updates made by those platforms that impact your campaigns or project.</p>

            <h2>Governing Law</h2>

            <p>These terms are governed by the laws of the State of Utah. Any disputes
            shall be resolved in the courts of Utah County, Utah.</p>

            <h2>Changes to These Terms</h2>

            <p>We may update these terms from time to time. The "Last updated" date
            at the top will always reflect the most recent version.</p>

        </div>

    </div>

</Layout>

